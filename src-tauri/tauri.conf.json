{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contact History",
  "version": "0.1.0",
  "identifier": "app.contacthistory.local",
  "build": { "beforeDevCommand": "bun run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "bun run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Contact History", "width": 1100, "height": 740, "minWidth": 760, "minHeight": 520 }], "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["nsis"] }
}
