{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "resolveJsonModule": true, "isolatedModules": true, "skipLibCheck": true,
    "types": ["svelte", "vite/client"]
  }, "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
